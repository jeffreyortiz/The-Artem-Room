# Netlify response headers
# Photos, icons and the font never change under the same name -> let browsers cache them for a year.
/img/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Olie's private dashboard: never in search results, never framed by another site
/bookings.html
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# Client deposit page: the link holds a private code, so keep it out of search and referrers
/deposit.html
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
